# ShelfScanner Environment Variables
# Copy this file to .env and fill in your values

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/shelfscanner
DB_NAME=shelfscanner

# App Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ML Model Paths
YOLO_MODEL_PATH=ml/book_detector/weights/best.pt
DATASET_PATH=ml/datasets/books.csv

# Optional: Hugging Face token (for private models)
HF_TOKEN=your_huggingface_token_here

# Optional: OpenAI API (for LLM chatbot feature)
OPENAI_API_KEY=your_openai_key_here
